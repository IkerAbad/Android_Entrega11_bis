<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/search_album">

    <fragment
        android:id="@+id/detail_album"
        android:name="com.jesuitasrioja.android_entrega11.detail_album"
        android:label="detail_album" >
        <action
            android:id="@+id/action_detail_album_to_search_album"
            app:destination="@id/search_album" />
    </fragment>
    <fragment
        android:id="@+id/search_album"
        android:name="com.jesuitasrioja.android_entrega11.ui.search_album"
        android:label="search_album" >
        <action
            android:id="@+id/action_search_album_to_detail_album"
            app:destination="@id/detail_album" />
    </fragment>
</navigation>